rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Questions : tout le monde peut lire (élèves + admin).
    // Seul un compte avec email (toi en admin) peut écrire.
    match /questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null;
    }

    // Participants : lecture publique pour le classement.
    // Création / mise à jour uniquement de SON propre document (anonyme ou non).
    // Le score peut au maximum augmenter de 1 par update.
    // Une question déjà répondue ne peut pas être modifiée (anti-rejouage).
    match /participants/{participantId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == participantId
        && request.resource.data.score == 0
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() >= 2
        && request.resource.data.pseudo.size() <= 30
        && request.resource.data.answered is map;

      allow update: if request.auth != null
        && request.auth.uid == participantId
        && request.resource.data.pseudo == resource.data.pseudo
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= resource.data.score + 1
        && request.resource.data.answered.diff(resource.data.answered).removedKeys().size() == 0
        && request.resource.data.answered.diff(resource.data.answered).changedKeys().size() == 0;

      // Seul l'admin peut supprimer.
      allow delete: if request.auth != null && request.auth.token.email != null;
    }
  }
}
