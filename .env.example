# Renomme ce fichier en .env (sans .example) et remplis avec les valeurs
# de ta config Firebase :
# Console Firebase > Paramètres du projet > Tes applications > Configuration SDK
#
# Ces valeurs sont publiques (visibles dans le code JS du site déployé) —
# c'est normal et voulu par Firebase. La sécurité passe par firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
